    "name": "Hypnotic Copper Dark",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "class": {
            "fontStyle": "",
            "foreground": "#B8A0C3"
        },
        "comment": {
            "fontStyle": "",
            "foreground": "#87929D"
        },
        "decorator": {
            "fontStyle": "",
            "foreground": "#DD8069"
        },
        "enum": {
            "fontStyle": "",
            "foreground": "#D69A59"
        },
        "enumMember": {
            "fontStyle": "",
            "foreground": "#D69A59"
        },
        "event": {
            "fontStyle": "",
            "foreground": "#83AFC9"
        },
        "function": {
            "fontStyle": "",
            "foreground": "#70B8C4"
        },
        "function.declaration": {
            "fontStyle": "",
            "foreground": "#70B8C4"
        },
        "function.defaultLibrary": {
            "fontStyle": "",
            "foreground": "#70B8C4"
        },
        "interface": {
            "fontStyle": "",
            "foreground": "#B8A0C3"
        },
        "keyword": {
            "fontStyle": "",
            "foreground": "#DD8069"
        },
        "label": {
            "fontStyle": "",
            "foreground": "#C9C5C1"
        },
        "macro": {
            "fontStyle": "",
            "foreground": "#C83E22"
        },
        "method": {
            "fontStyle": "",
            "foreground": "#70B8C4"
        },
        "method.declaration": {
            "fontStyle": "",
            "foreground": "#82C3CC"
        },
        "method.defaultLibrary": {
            "fontStyle": "",
            "foreground": "#70B8C4"
        },
        "namespace": {
            "fontStyle": "",
            "foreground": "#83AFC9"
        },
        "number": {
            "fontStyle": "",
            "foreground": "#D69A59"
        },
        "operator": {
            "fontStyle": "",
            "foreground": "#C9C5C1"
        },
        "parameter": {
            "fontStyle": "",
            "foreground": "#D6D3CF"
        },
        "property": {
            "fontStyle": "",
            "foreground": "#D6D3CF"
        },
        "property.readonly": {
            "fontStyle": "",
            "foreground": "#83AFC9"
        },
        "regexp": {
            "fontStyle": "",
            "foreground": "#A9C58D"
        },
        "string": {
            "fontStyle": "",
            "foreground": "#A9C58D"
        },
        "struct": {
            "fontStyle": "",
            "foreground": "#B8A0C3"
        },
        "type": {
            "fontStyle": "",
            "foreground": "#B8A0C3"
        },
        "typeParameter": {
            "fontStyle": "",
            "foreground": "#C9B5D0"
        },
        "variable": {
            "fontStyle": "",
            "foreground": "#D6D3CF"
        },
        "variable.defaultLibrary": {
            "fontStyle": "",
            "foreground": "#D6D3CF"
        },
        "variable.readonly": {
            "fontStyle": "",
            "foreground": "#83AFC9"
        }
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#87929D"
            }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.other.object"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#D6D3CF"
            }
        },
        {
            "name": "Parameters",
            "scope": [
                "variable.parameter"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#BBC4CC"
            }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#DD8069"
            }
        },
        {
            "name": "C++ Return Keywords",
            "scope": [
                "keyword.control.return.cpp",
                "meta.block.cpp keyword.control.return.cpp",
                "meta.body.function.definition.cpp keyword.control.return.cpp",
                "meta.function.definition.cpp keyword.control.return.cpp"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#DD8069"
            }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "variable.function"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#70B8C4"
            }
        },
        {
            "name": "C++ Function Definitions",
            "scope": [
                "entity.name.function.definition.cpp",
                "meta.head.function.definition.cpp entity.name.function.definition.cpp",
                "meta.function.definition.cpp entity.name.function.definition.cpp"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#70B8C4"
            }
        },
        {
            "name": "Python Function Declarations",
            "scope": [
                "entity.name.function.python",
                "meta.function.python entity.name.function.python"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#70B8C4"
            }
        },
        {
            "name": "Methods",
            "scope": [
                "entity.name.function.member",
                "meta.method-call",
                "support.function.method"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#82C3CC"
            }
        },
        {
            "name": "Types & Classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#B8A0C3"
            }
        },
        {
            "name": "C++ Primitive Types",
            "scope": [
                "storage.type.built-in.primitive.cpp",
                "storage.type.primitive.cpp",
                "meta.qualified_type.cpp storage.type.built-in.primitive.cpp",
                "meta.qualified_type.cpp storage.type.primitive.cpp"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#F08C7A"
            }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "punctuation.definition.string"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#A9C58D"
            }
        },
        {
            "name": "Python String Storage Types",
            "scope": [
                "storage.type.string.python",
                "meta.fstring.python storage.type.string.python",
                "meta.function-call.arguments.python storage.type.string.python",
                "meta.function-call.python storage.type.string.python",
                "meta.member.access.python storage.type.string.python"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#D38A73"
            }
        },
        {
            "name": "Python Strings",
            "scope": [
                "string.quoted.single.python",
                "string.interpolated.python",
                "meta.fstring.python string.quoted.single.python",
                "meta.fstring.python string.interpolated.python",
                "meta.function-call.arguments.python string.quoted.single.python",
                "meta.function-call.arguments.python string.interpolated.python",
                "meta.function-call.python string.quoted.single.python",
                "meta.function-call.python string.interpolated.python",
                "meta.member.access.python string.quoted.single.python",
                "meta.member.access.python string.interpolated.python"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#A9C58D"
            }
        },
        {
            "name": "Numbers & Booleans",
            "scope": [
                "constant.numeric",
                "constant.language.boolean",
                "keyword.other.unit"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#D69A59"
            }
        },
        {
            "name": "Constants",
            "scope": [
                "constant",
                "support.constant",
                "constant.other"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#D38A73"
            }
        },
        {
            "name": "Namespaces",
            "scope": [
                "entity.name.namespace"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#83AFC9"
            }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#C9C5C1"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#C7C3BF"
            }
        },
        {
            "name": "HTML/XML Tags",
            "scope": [
                "entity.name.tag"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#DD8069"
            }
        },
        {
            "name": "HTML Attributes",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#83AFC9"
            }
        },
        {
            "name": "Invalid or Deprecated",
            "scope": [
                "invalid",
                "invalid.illegal",
                "invalid.deprecated"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#F08C7A"
            }
        }
    ],
    "type": "dark"
}
