    "name": "Hypnotic Copper Glow",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "class": {
            "fontStyle": "",
            "foreground": "#267F99"
        },
        "comment": {
            "fontStyle": "",
            "foreground": "#6E737A"
        },
        "decorator": {
            "fontStyle": "",
            "foreground": "#9E4C3B"
        },
        "enum": {
            "fontStyle": "",
            "foreground": "#A15C16"
        },
        "enumMember": {
            "fontStyle": "",
            "foreground": "#A15C16"
        },
        "event": {
            "fontStyle": "",
            "foreground": "#8A6157"
        },
        "function": {
            "fontStyle": "",
            "foreground": "#8250DF"
        },
        "function.declaration": {
            "fontStyle": "",
            "foreground": "#8250DF"
        },
        "function.defaultLibrary": {
            "fontStyle": "",
            "foreground": "#8250DF"
        },
        "interface": {
            "fontStyle": "",
            "foreground": "#6B4F49"
        },
        "keyword": {
            "fontStyle": "",
            "foreground": "#9E4C3B"
        },
        "label": {
            "fontStyle": "",
            "foreground": "#4B4F54"
        },
        "macro": {
            "fontStyle": "",
            "foreground": "#CF222E"
        },
        "method": {
            "fontStyle": "",
            "foreground": "#8250DF"
        },
        "method.declaration": {
            "fontStyle": "",
            "foreground": "#8250DF"
        },
        "method.defaultLibrary": {
            "fontStyle": "",
            "foreground": "#8250DF"
        },
        "namespace": {
            "fontStyle": "",
            "foreground": "#8A6157"
        },
        "number": {
            "fontStyle": "",
            "foreground": "#A15C16"
        },
        "operator": {
            "fontStyle": "",
            "foreground": "#4B4F54"
        },
        "parameter": {
            "fontStyle": "",
            "foreground": "#1F2328"
        },
        "property": {
            "fontStyle": "",
            "foreground": "#1F2328"
        },
        "property.readonly": {
            "fontStyle": "",
            "foreground": "#8A6157"
        },
        "regexp": {
            "fontStyle": "",
            "foreground": "#0A3069"
        },
        "string": {
            "fontStyle": "",
            "foreground": "#567c30"
        },
        "struct": {
            "fontStyle": "",
            "foreground": "#6B4F49"
        },
        "type": {
            "fontStyle": "",
            "foreground": "#6B4F49"
        },
        "typeParameter": {
            "fontStyle": "",
            "foreground": "#8A6157"
        },
        "variable": {
            "fontStyle": "",
            "foreground": "#1F2328"
        },
        "variable.defaultLibrary": {
            "fontStyle": "",
            "foreground": "#1F2328"
        },
        "variable.readonly": {
            "fontStyle": "",
            "foreground": "#8A6157"
        }
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#6E737A"
            }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.other.object"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#1F2328"
            }
        },
        {
            "name": "Parameters",
            "scope": [
                "variable.parameter"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#4E4C48"
            }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#9E4C3B"
            }
        },
        {
            "name": "C++ Return Keywords",
            "scope": [
                "keyword.control.return.cpp",
                "meta.block.cpp keyword.control.return.cpp",
                "meta.body.function.definition.cpp keyword.control.return.cpp",
                "meta.function.definition.cpp keyword.control.return.cpp"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#AF00DB"
            }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "variable.function"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#8250DF"
            }
        },
        {
            "name": "Python Function Declarations",
            "scope": [
                "entity.name.function.python",
                "meta.function.python entity.name.function.python"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#8250DF"
            }
        },
        {
            "name": "C++ Function Definitions",
            "scope": [
                "entity.name.function.definition.cpp",
                "meta.head.function.definition.cpp entity.name.function.definition.cpp",
                "meta.function.definition.cpp entity.name.function.definition.cpp"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#8250DF"
            }
        },
        {
            "name": "Methods",
            "scope": [
                "entity.name.function.member",
                "meta.method-call",
                "support.function.method"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#8250DF"
            }
        },
        {
            "name": "Types & Classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#267F99"
            }
        },
        {
            "name": "C++ Primitive Types",
            "scope": [
                "storage.type.built-in.primitive.cpp",
                "storage.type.primitive.cpp",
                "meta.qualified_type.cpp storage.type.built-in.primitive.cpp",
                "meta.qualified_type.cpp storage.type.primitive.cpp"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#CF222E"
            }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "punctuation.definition.string"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#567c30"
            }
        },
        {
            "name": "Python String Storage Types",
            "scope": [
                "storage.type.string.python",
                "meta.fstring.python storage.type.string.python",
                "meta.function-call.arguments.python storage.type.string.python",
                "meta.function-call.python storage.type.string.python",
                "meta.member.access.python storage.type.string.python"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#CF222E"
            }
        },
        {
            "name": "Python Strings",
            "scope": [
                "string.quoted.single.python",
                "string.interpolated.python",
                "meta.fstring.python string.quoted.single.python",
                "meta.fstring.python string.interpolated.python",
                "meta.function-call.arguments.python string.quoted.single.python",
                "meta.function-call.arguments.python string.interpolated.python",
                "meta.function-call.python string.quoted.single.python",
                "meta.function-call.python string.interpolated.python",
                "meta.member.access.python string.quoted.single.python",
                "meta.member.access.python string.interpolated.python"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#0A3069"
            }
        },
        {
            "name": "Numbers & Booleans",
            "scope": [
                "constant.numeric",
                "constant.language.boolean",
                "keyword.other.unit"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#A15C16"
            }
        },
        {
            "name": "Constants",
            "scope": [
                "constant",
                "support.constant",
                "constant.other"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#8A6157"
            }
        },
        {
            "name": "Namespaces",
            "scope": [
                "entity.name.namespace"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#8A6157"
            }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#4B4F54"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#4B4F54"
            }
        },
        {
            "name": "HTML/XML Tags",
            "scope": [
                "entity.name.tag"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#9E4C3B"
            }
        },
        {
            "name": "HTML Attributes",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#8A6157"
            }
        },
        {
            "name": "Invalid or Deprecated",
            "scope": [
                "invalid",
                "invalid.illegal",
                "invalid.deprecated"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#B42318"
            }
        }
    ],
    "type": "light"
}
